# Configuración de referencia. La copia local se guarda en backend/.env.
# Credencial propia del operador; protege consulta de estado y comandos.
# Una clave vacía deshabilita el acceso a la API del backend.
OPERATOR_API_KEY=

# Credencial del gateway privado del LLM, pendiente de entrega e integración.
# No se incluye en el prompt ni se introduce en el frontend.
LLM_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Esta versión expresa los saldos en USDT y admite pares con esa moneda cotizada.
SYMBOL=BTCUSDT

# Fracciones en el intervalo (0, 1]. La exposición limita el monto de una compra.
MAX_EXPOSURE=0.5
MAX_DAILY_LOSS=0.03
# Antigüedad máxima desde el cierre de la última vela, en horas.
MAX_DATA_AGE_HOURS=48
